# Catalog stack — VPS environment template.
#
# Copy to `templates/.env` and fill in real values:
#   cp .env.example .env
# The compose file reads THIS file (compose interpolates ${VAR} from .env
# next to docker-compose.yml). Every variable has a DEV default in the
# compose file, but on a public VPS you MUST override the three secrets.

# ── Postgres ────────────────────────────────────────────────────────────────
# Fine to keep as-is for a single-server deploy; the DB port should be
# firewalled so only the host can reach it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=store_mgmt

# ── Secrets (MANDATORY overrides in production) ────────────────────────────
# Generate each with:  openssl rand -hex 32   (see README for alternatives)
JWT_SECRET=change-me-openssl-rand-hex-32
REFRESH_TOKEN_SECRET=change-me-openssl-rand-hex-32
SESSION_SECRET=change-me-openssl-rand-hex-32

# Optional: token lifetimes (defaults shown)
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Image storage / CDN (optional) ──────────────────────────────────────────
# Internal container path of the shared image volume — change only if you
# also change the volume mount in docker-compose.yml.
STORAGE_PATH=/data/storage
# Public base URL for assembled image links (e.g. https://cdn.example.com).
# Leave empty to serve relative paths.
PUBLIC_ASSET_BASE_URL=
