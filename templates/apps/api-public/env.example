PORT=3003

# Phase 4: PublicTenantGuard resolves the tenant via ICompanyRepository
# (master schema); every product/category read then opens the resolved
# tenant schema through the same Postgres instance api-salesops uses.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/store_mgmt?schema=public"

# Where FsImageStore (packages/infra-storage) reads product/category image
# bytes from — MUST match api-salesops's STORAGE_PATH (same volume, one
# writer, one reader; design.md §5/§8).
STORAGE_PATH=./storage

# Optional: prefixes every assembled /public/products/:id/image/:key URL
# (design.md D6) once a CDN sits in front of this app. Unset -> relative path.
# PUBLIC_ASSET_BASE_URL=
