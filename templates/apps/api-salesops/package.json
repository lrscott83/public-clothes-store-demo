{
  "name": "@store-mgmt/api-salesops",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:local": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@store-mgmt/api-common": "workspace:*",
    "@store-mgmt/domain": "workspace:*",
    "@store-mgmt/infra-db": "workspace:*",
    "@store-mgmt/infra-storage": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@store-mgmt/eslint-config": "workspace:*",
    "@store-mgmt/typescript-config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.31.0",
    "jest": "^30.0.0",
    "jsonwebtoken": "^9.0.3",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "setupFiles": [
      "<rootDir>/../jest.setup.js"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": ["**/*.ts", "!**/*.spec.ts", "!**/index.ts", "!**/*.module.ts", "!**/main.ts"],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 73,
        "functions": 93,
        "lines": 89
      }
    }
  }
}
