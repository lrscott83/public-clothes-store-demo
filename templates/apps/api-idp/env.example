# Postgres is the shared poolops-postgres container (creds postgres/postgres),
# database `store_mgmt`. It runs in host-network mode on the Docker host's port
# 5432. On the same host use `localhost`; from a sibling container (e.g. a Coder
# workspace) use the Docker bridge gateway, e.g. 172.17.0.1.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/store_mgmt?schema=public"
PORT=3002

# HS256 shared secret (ADR-4) — MUST match apps/api-salesops's JWT_SECRET so
# tokens issued here verify there. Never reuse the dev fallback in production.
JWT_SECRET="store-mgmt-dev-jwt-secret-change-me"
REFRESH_TOKEN_SECRET="store-mgmt-dev-refresh-secret-change-me"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
