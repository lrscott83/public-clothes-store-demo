# Postgres is the shared poolops-postgres container (creds postgres/postgres),
# database `store_mgmt`. It runs in host-network mode, so it listens on the
# Docker host's port 5432. On the same host use `localhost`; from a sibling
# container (e.g. a Coder workspace) use the Docker bridge gateway, e.g. 172.17.0.1.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/store_mgmt?schema=public"
