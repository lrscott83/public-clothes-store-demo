generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// First domain module: Currency / exchange rates (SDD change backend-currency).
// Append-only: no updatedAt, no soft-delete, no valid_to. A rate change is a
// new INSERT; "current rate" = latest row with effectiveFrom <= at.

enum PaymentChannel {
  ZELLE
  USD_CASH
  EUR_CASH
  MN_TRANSFER
  MN_CASH
}

enum Currency {
  USD
  EUR
  MN
}

model ExchangeRate {
  id            String         @id @default(uuid()) @db.Uuid
  channel       PaymentChannel
  rate          Decimal        @db.Decimal(18, 6) // NUMERIC — never float
  effectiveFrom DateTime       @map("effective_from")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([channel, effectiveFrom])
  @@map("exchange_rate")
}

// Second domain module: Products & Categories (SDD change backend-products).
// Mutable master data -> BOTH created_at + updated_at (unlike the
// append-only ExchangeRate above). Soft-delete via `active`, never a hard
// DELETE — order-history FK references must never be orphaned.

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  image     String?
  icon      String?
  order     Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("category")
}

model Product {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  description          String
  sku                  String?
  barcode              String?
  price                Decimal  @db.Decimal(18, 2) // NUMERIC — never float
  priceCurrency        String   @map("price_currency")
  percentDiscountPrice Decimal  @default(0) @map("percent_discount_price") @db.Decimal(5, 2)
  discountPrice        Decimal  @default(0) @map("discount_price") @db.Decimal(18, 2)
  cost                 Decimal  @db.Decimal(18, 2)
  costCurrency         String   @map("cost_currency")
  categoryId           String   @map("category_id") @db.Uuid
  image                String
  isNew                Boolean  @default(false) @map("is_new")
  order                Int
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  category    Category        @relation(fields: [categoryId], references: [id])
  // Inverse relations only — Product carries ZERO inventory scalar fields
  // (see design.md decision #10; `rg -i "stock|warehouse"` under
  // packages/domain/src/product/ must stay 0).
  stockLevels StockLevel[]
  movements   StockMovement[]
  // Inverse relation only — added by the Sales module (backend-ventas).
  orderLines  OrderLine[]

  @@index([categoryId])
  @@map("product")
}

// Third domain module: Almacenes + Inventario (SDD change backend-inventory).
// `Warehouse`/`StockLevel` are mutable master data -> BOTH created_at +
// updated_at. `StockMovement` is an append-only audit log -> created_at
// only, no soft-delete (mirrors ExchangeRate). `onHand` mutates ONLY via a
// recorded StockMovement, inside one prisma.$transaction (design.md's
// central decision) — no direct "set onHand" write anywhere.

enum StockMovementType {
  purchase_in
  sale_out
  transfer_in
  transfer_out
  adjustment_in
  adjustment_out
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockLevels        StockLevel[]
  movements          StockMovement[]
  // Inverse relation only — added by the Sales module (backend-ventas).
  orders             Order[]
  // Inverse relation only — added by the Users/Roles module (backend-users-roles).
  warehouseOperators WarehouseOperator[]

  @@map("warehouse")
}

model StockLevel {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  onHand      Int      @default(0) @map("on_hand")
  reserved    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  // DB backstop (raw SQL in migration): CHECK (on_hand >= 0 AND reserved >= 0)
  // DB backstop (raw SQL in migration, W4): CHECK (reserved <= on_hand) —
  // IMMEDIATE, makes deliver's release-before-sale_out ordering load-bearing.

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("stock_level")
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  warehouseId String            @map("warehouse_id") @db.Uuid
  type        StockMovementType
  quantity    Int // positive magnitude; type implies direction
  reason      String?
  createdBy   String?           @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([productId, warehouseId])
  @@map("stock_movement")
}

// Fourth domain module: Clientes (SDD change backend-customers). Flat master
// data -> BOTH created_at + updated_at. Soft-delete via `active`, never a
// hard DELETE — a future Sales SaleCredit/Order FK must never be orphaned.
// `documentId` is optional and unique-when-present: a plain @unique on a
// nullable column allows many NULLs (Postgres treats NULLs as distinct)
// while rejecting duplicate non-null values — no partial index needed
// (design.md). NO relations — the Sales FK is a future change.
// MODIFIED by the Users/Roles module (backend-users-roles): added the
// REQUIRED, UNIQUE `userId` FK (1:1 with `User`) — every Customer now
// references exactly one login identity. See the migration in
// prisma/migrations/*_add_users_roles_module for the backfill sequence that
// made this NOT NULL against pre-existing rows.
model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  fullName   String   @map("full_name")
  documentId String?  @unique @map("document_id")
  cellPhone  String?  @map("cell_phone")
  email      String?
  address    String?
  note       String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  // Inverse relations only — added by the Sales module (SDD change
  // backend-ventas). Customer carries zero Sales scalar fields.
  orders      Order[]
  saleCredits SaleCredit[]

  @@map("customer")
}

// Fifth domain module: Sales (SDD change backend-ventas). `Order` is the
// aggregate root — persists/loads with `OrderLine[]`/`OrderPayment[]`/an
// optional `SaleCredit` as ONE unit (design.md decision #1). Mutable ->
// created_at + updated_at. An Order is an immutable transactional EVENT: it
// is NEVER deleted (no hard DELETE and NO soft-delete `active` flag either) —
// its whole lifecycle lives in the `OrderStatus` machine
// (created/verified/delivered/cancelled). Mirrors the append-only
// `StockMovement`/`ExchangeRate` records. `OrderLine`/`OrderPayment` carry
// `onDelete: Cascade` as defense-in-depth (children are meaningless without
// the root; the root is never deleted, so cascade only guards accidental
// removal).
//
// DEVIATION from design.md's literal Prisma block (flagged, not a domain
// change): design.md was written BEFORE Phase 3 locked the actual domain
// shape. The frozen `OrderLine.rateApplied`/`OrderPayment.rateApplied`/
// `SaleCredit.rateApplied` are full `ExchangeRate` objects
// (`{id?, channel, rate, effectiveFrom}`), not a bare `bigint` — so each
// needs its own `rateChannel` column (design.md omitted it) to round-trip
// losslessly, since a resolved rate's channel is NOT always the same as
// `OrderPayment.channel` (cross-currency payments resolve the DEST-side
// channel, per `convert`). `SaleCredit` likewise needs its own
// `rateApplied`/`rateChannel`/`rateEffectiveFrom` — design.md's SaleCredit
// block omitted them entirely, but the frozen `SaleCredit` domain
// interface requires them. All additions below are ADDITIVE (new nullable
// -free-but-newly-introduced columns on brand-new tables) — no existing
// table changes.

enum OrderStatus {
  created
  verified
  delivered
  cancelled
}

enum DeliveryMode {
  pickup
  delivery
}

model Order {
  id                      String       @id @default(uuid()) @db.Uuid
  customerId              String       @map("customer_id") @db.Uuid
  customerName            String       @map("customer_name") // snapshot
  warehouseId             String       @map("warehouse_id") @db.Uuid
  deliveryMode            DeliveryMode @map("delivery_mode") // REQUIRED; delivery engages future Delivery module
  currency                String // derived USD|MN
  status                  OrderStatus  @default(created)
  subtotal                Decimal      @db.Decimal(18, 2) // Money in `currency`
  discountTotal           Decimal      @map("discount_total") @db.Decimal(18, 2)
  total                   Decimal      @db.Decimal(18, 2)
  /// `CompanyUser.id` of the sales agent this sale is credited to. NULLABLE only because
  /// orders predating this column exist and are deliberately NOT backfilled — inventing an
  /// agent for a historical sale would fabricate financial evidence. Every order written
  /// after the cutover carries it (the domain input is required, not optional).
  attributedCompanyUserId String?      @map("attributed_company_user_id") @db.Uuid
  orderDate               DateTime     @map("order_date")
  verifiedAt              DateTime?    @map("verified_at") // freeze stamp (rate+totals, NO commission)
  deliveredAt             DateTime?    @map("delivered_at") // stamped at verified->delivered
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  customer              Customer       @relation(fields: [customerId], references: [id])
  warehouse             Warehouse      @relation(fields: [warehouseId], references: [id])
  lines                 OrderLine[]
  payments              OrderPayment[]
  saleCredit            SaleCredit?
  /// RESTRICT, not SET NULL: an assignment that has sales against it must not be deletable,
  /// because nulling the column would silently erase who earned the commission. Retiring an
  /// agent is a `status` change on `company_user`, never a delete.
  attributedCompanyUser CompanyUser?   @relation(fields: [attributedCompanyUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([customerId])
  @@index([attributedCompanyUserId])
  @@map("sales_order") // "order" is a SQL reserved word
}

model OrderLine {
  id                   String         @id @default(uuid()) @db.Uuid
  orderId              String         @map("order_id") @db.Uuid
  productId            String         @map("product_id") @db.Uuid
  productName          String         @map("product_name") // snapshot
  categoryName         String         @map("category_name") // snapshot
  price                Decimal        @db.Decimal(18, 2) // native
  priceCurrency        String         @map("price_currency") // native currency
  percentDiscountPrice Decimal        @default(0) @map("percent_discount_price") @db.Decimal(5, 2)
  discountPrice        Decimal        @default(0) @map("discount_price") @db.Decimal(18, 2)
  quantity             Int
  unitFinalPrice       Decimal        @map("unit_final_price") @db.Decimal(18, 2) // native
  lineTotalNative      Decimal        @map("line_total_native") @db.Decimal(18, 2) // native
  rateApplied          Decimal        @map("rate_applied") @db.Decimal(18, 6) // scale-6
  rateChannel          PaymentChannel @map("rate_channel") // see module-level DEVIATION note
  rateEffectiveFrom    DateTime       @map("rate_effective_from")
  lineTotalOrder       Decimal        @map("line_total_order") @db.Decimal(18, 2) // in Order.currency, frozen
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_line")
}

model OrderPayment {
  id                    String         @id @default(uuid()) @db.Uuid
  orderId               String         @map("order_id") @db.Uuid
  channel               PaymentChannel
  amount                Decimal        @db.Decimal(18, 2) // in CHANNEL_CURRENCY[channel]
  rateApplied           Decimal        @map("rate_applied") @db.Decimal(18, 6)
  rateChannel           PaymentChannel @map("rate_channel") // see module-level DEVIATION note
  rateEffectiveFrom     DateTime       @map("rate_effective_from")
  amountInOrderCurrency Decimal        @map("amount_in_order_currency") @db.Decimal(18, 2) // Order.currency
  createdAt             DateTime       @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_payment")
}

model SaleCredit {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @unique @map("order_id") @db.Uuid // 0..1
  customerId        String         @map("customer_id") @db.Uuid // FK, replaces legacy `client: string`
  total             Decimal        @db.Decimal(18, 2) // Order.currency
  paid              Decimal        @default(0) @db.Decimal(18, 2) // Order.currency
  rateApplied       Decimal        @map("rate_applied") @db.Decimal(18, 6) // see module-level DEVIATION note
  rateChannel       PaymentChannel @map("rate_channel")
  rateEffectiveFrom DateTime       @map("rate_effective_from")
  paidDate          DateTime?      @map("paid_date")
  paidType          String?        @map("paid_type")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@map("sale_credit")
}

// Sixth domain module: Users / Roles / Autenticación (SDD change
// backend-users-roles). Isolated identity module, api-idp pattern — see
// design.md. `User` maps to table "app_user", NOT "user" (USER is a Postgres
// reserved word, same reason `Order` maps to "sales_order"). `login` (NOT
// `email`) is the unique, required authentication identifier. `User` carries
// NO role bitmask — migration 002 dropped `app_user.roles`; authorization is
// a property of the `(user, company)` pair and lives on `CompanyUser`.

model User {
  id           String   @id @default(uuid()) @db.Uuid
  login        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  email        String?
  cellPhone    String?  @map("cell_phone")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  warehouseOperator   WarehouseOperator? // 0..1 detail
  customer            Customer? // inverse of the 1:1 link

  @@map("app_user")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique // opaque rtid (crypto.randomBytes hex)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique // opaque single-use token
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

// Per-warehouse scope detail for a user holding the `warehouse_operator`
// role. `userId` is both PK and FK (1:1 with `User`). `warehouseId` is
// deliberately NOT unique — a single `Warehouse` MAY have many operators.
model WarehouseOperator {
  userId      String   @id @map("user_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId])
  @@map("warehouse_operator")
}

// Seventh domain module: Companies / CompanyUser role reframe (SDD change
// company-user-roles-reframe, Phase 1 — additive only, INERT: nothing reads
// these tables yet, `app_user.roles` remains the live source of authz until
// the Phase 2 behavioral cutover). Single schema-per-tenant (design.md D1/D3):
// exactly one `Company` row exists in production today.

enum CompanyUserStatus {
  ACTIVE
  REVOKED
  SUSPENDED
}

model Company {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  slug       String   @unique
  isActive   Boolean  @default(true) @map("is_active")
  /// Reserved hook for the deferred schema-per-tenant change (D3). ALWAYS null today — no code path may read it.
  schemaName String?  @map("schema_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  companyUsers CompanyUser[]

  @@map("company")
}

model CompanyUser {
  id        String            @id @default(uuid()) @db.Uuid
  /// SOFT FK to `app_user.id` — deliberately NOT a Prisma `@relation` (D1): this table is
  /// the one the deferred schema-per-tenant change moves tenant-side, where a relation to
  /// the master `User` cannot be expressed. Integrity is an APPLICATION invariant.
  /// If a hard user-delete path is ever added it MUST delete `company_user` rows in the
  /// same transaction. Today `User` is soft-delete-only (`UsersService.deactivate`).
  userId    String            @map("user_id") @db.Uuid
  companyId String            @map("company_id") @db.Uuid
  role      Int
  status    CompanyUserStatus @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  company          Company @relation(fields: [companyId], references: [id])
  attributedOrders Order[]

  @@unique([userId, companyId])
  @@index([userId])
  @@map("company_user")
}
