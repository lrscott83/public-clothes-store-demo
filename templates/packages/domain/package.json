{
  "name": "@store-mgmt/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint \"src/**/*.ts\" --fix --max-warnings 0",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@store-mgmt/eslint-config": "workspace:*",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^3.2.3",
    "eslint": "^9.31.0",
    "rimraf": "^6.0.1",
    "typescript": "^5",
    "vitest": "^3.2.3"
  },
  "files": [
    "dist"
  ]
}
